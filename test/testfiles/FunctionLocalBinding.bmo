//! base 0.1.0
package 'FunctionLocalBinding'
  function 'f' "A local with a value, as OpenModelica exports it, also depending on an input"
    input Real 'x';
    output Real 'y';
    Real 'k' = 50.0;
    Real 'm' = 2.0 * 'x';
  algorithm
    'y' := 'k' * 'x' + 'm';
  end 'f';
  model 'FunctionLocalBinding'
    Real 'a';
    Real 'b';
  equation
    'a' = 'f'('b');
  end 'FunctionLocalBinding';
end 'FunctionLocalBinding';

