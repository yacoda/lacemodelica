//! base 0.1.0
package 'ModelDescriptionAttributes'
  record 'Point'
    Real 'x';
    Real 'y';
  end 'Point';

  model 'ModelDescriptionAttributes' "Causality, nominal, fixed and initial; see test_model_description.py"
    parameter Real 'scale' = 2.0;
    input Real 'u'(fixed = true, nominal = 5.0);
    input Real 'v'(fixed = false);
    output Real 'y'(nominal = 'scale' * 3.0);
    Real 'x'(min = 2.0 * 'scale');
    Real 'a'(fixed = true, start = 1.0);
    Real 'b'(fixed = false, start = 2.0);
    Real 'c'(start = 3.0);
    Real 'e'(fixed = true, start = 2.0 * 'scale');
    output Real 'z'(fixed = true, start = 0.5);
    Real 'f'(fixed = true);
    Boolean 'g'(fixed = true);
    'Point' 'p'(x(fixed = true, start = 1.0), y(start = 2.0));
    'Point' 'q'(x(fixed = true, start = 3.0 * 'scale'), y(fixed = true));
    Real 'w' "Uses time, an input before all variables";
  initial equation
    'b' = 2.5;
  equation
    der('x') = 'u' + 'v';
    'y' = 'x';
    der('a') = -'a';
    der('b') = 'a';
    'c' = 'a' + 'b';
    der('e') = -'e';
    der('z') = 'u';
    der('p.x') = -'p.y';
    der('p.y') = 'p.x';
    der('f') = 'f';
    'g' = 'f' > 1.0;
    der('q.x') = -'q.y';
    der('q.y') = 'q.x';
    der('w') = time;
  end 'ModelDescriptionAttributes';
end 'ModelDescriptionAttributes';
