//! base 0.1.0
package 'ParenthesizedSubscript'
  model 'ParenthesizedSubscript' "A subscript on a parenthesized array, as OpenModelica exports a comprehension"
    parameter Real 'a' = 2.0;
    Real 'x';
    Real 'y';
  equation
    'x' = (3.0 * {'a' * 'i' for 'i' in 1:4})[2];
    'y' = ({1.0, 'a', 5.0})[3];
  end 'ParenthesizedSubscript';
end 'ParenthesizedSubscript';

