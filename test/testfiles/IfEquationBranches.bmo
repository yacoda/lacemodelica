//! base 0.1.0
package 'IfEquationBranches'
  model 'IfEquationBranches' "If-equations with several equations per branch, and nested ones"
    parameter Boolean 'p' = true;
    parameter Boolean 'q' = true;
    Real 'a';
    Real 'b';
    Real 'c';
    Real 'd';
    Real 'e';
  equation
    if 'p' then
      'a' = 1.0;
      'b' = 2.0;
    else
      'b' = 4.0;
      'a' = 'b' + 1.0;
    end if;
    if 'p' then
      if 'q' then
        'c' = 10.0;
      else
        'c' = 20.0;
      end if;
      2.0 * 'd' = 2.0;
    else
      'c' = 30.0;
      'd' = 3.0;
    end if;
    if 'q' then
      'e' = 'a';
    elseif true then
      'e' = 'b';
    end if;
  end 'IfEquationBranches';
end 'IfEquationBranches';

