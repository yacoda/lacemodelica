// The value of a variable in its declaration is an equation. That of a parameter
// is its value, and a start attribute stays a start value.

//! base 0.1.0
package 'DeclarationEquation'
  model 'DeclarationEquation'
    parameter Real 'p' = 2.0;
    input Real 'u';
    Real 'x'(start = 1.0);
    Real 'y' = 3.0 * 'x';
    output Real 'z' = 'y' + 'u';
    Real 'v'[2](start = 'p' * {1.0, 2.0}) = 'p' * {'x', 'u'};
  equation
    der('x') = -'x';
  end 'DeclarationEquation';
end 'DeclarationEquation';

