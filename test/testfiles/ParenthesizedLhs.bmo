//! base 0.1.0
package 'ParenthesizedLhs'
  model 'ParenthesizedLhs' "A parenthesized expression at the start of a left-hand side is not a tuple"
    parameter Boolean 'p' = true;
    Real 'x';
    Real 'y';
  equation
    (if 'p' then 1.0 else 0.0) * 'x' + 'y' = 0.0;
    ('x' + 'y') = 2.0;
  end 'ParenthesizedLhs';
end 'ParenthesizedLhs';

