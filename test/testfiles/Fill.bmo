// fill() in equations and in attributes, also for an array without elements,
// as tools write for the attributes of an empty array.

//! base 0.1.0
package 'Fill'
  model 'Fill'
    parameter Real 'k' = 2.0;
    Real 'x';
    Real 'v'[3];
    Real 'm'[2, 3](start = fill('k', 2, 3));
    Real 'q'[0](start = fill(0.001, 0), nominal = fill('k', 0));
  equation
    der('x') = -'k' * 'x';
    'v' = fill('k' * 'x', 3);
    'm' = fill(1.5, 2, 3);
  end 'Fill';
end 'Fill';

