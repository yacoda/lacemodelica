//! base 0.1.0
package 'MinMaxBinary'
  model 'MinMaxBinary' "min and max with two arguments, in equations and in attributes"
    parameter Real 'p' = 1.0;
    parameter Real 'q' = 2.0;
    Real 'x'(min = max('p', 'q'), max = min('p', 'q') + 5.0);
    Real 'y';
    Real 'z';
  equation
    'y' = min('x', 'p');
    'z' = max('x', 'q');
  end 'MinMaxBinary';
end 'MinMaxBinary';

