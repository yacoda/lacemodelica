//! base 0.1.0
package 'DelayCall'
  model 'DelayCall' "delay() is an extra input, with outputs for its expression and duration"
    parameter Real 'tau' = 3.0;
    Real 'x';
    Real 'y';
  equation
    'y' = delay(2.0 * 'x', 'tau', 'tau') / 4.0;
    'x' = 1.0;
  end 'DelayCall';
end 'DelayCall';

