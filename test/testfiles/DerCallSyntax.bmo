//! base 0.1.0
package 'DerCallSyntax'
  pure function under "A function whose name ends in der"
    input Real 'u';
    output Real 'y';
  algorithm
    'y' := 2.0 * 'u';
  end under;

  model 'DerCallSyntax' "der() calls that a text search for der( up to ) gets wrong"
    Real 'x'[2];
    Real 'a)b'(start = 1.0) "A quoted name with a closing parenthesis";
    Real 'w' "No state, the argument of under";
    Real 'v';
    Real 'z' "No state, in the name of 'k der(z)'";
    Real 'k der(z)';
  equation
    der('x'[1]) = -'x'[1];
    der('x'[2 * (1)]) = -'x'[2];
    der('a)b') = -'a)b';
    'w' = 1.0;
    'v' = under('w');
    'z' = 2.0;
    'k der(z)' = 'z';
  end 'DerCallSyntax';
end 'DerCallSyntax';

