//! base 0.1.0
package 'QuotedLoopIndex'
  function 'f' "A quoted index in a for-statement"
    output Real 'y';
  algorithm
    'y' := 0.0;
    for 'k' in 1:3 loop
      'y' := 'y' + 'k';
    end for;
  end 'f';
  model 'QuotedLoopIndex' "A quoted index, as OpenModelica exports it, counts from the start of its range"
    Real 'x'[3];
    Real 'y';
    Real 'z';
  equation
    for 'i' in 1:3 loop
      'x'['i'] = 'i';
    end for;
    'y' = sum('i' * 2.0 for 'i' in 1:3);
    'z' = 'f'();
  end 'QuotedLoopIndex';
end 'QuotedLoopIndex';

